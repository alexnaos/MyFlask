# =============================================================================
# myflask — переменные окружения для docker-compose.yml (прод)
# Скопируйте в .env рядом с docker-compose.yml и заполните. .env НЕ коммитить.
# =============================================================================

# --- Образ / реестр ----------------------------------------------------------
IMAGE=ghcr.io/alexnaos/myflask:latest

# --- Адрес прослушивания контейнера app -------------------------------------
#  Основной сервер (Debian 103):  BIND_ADDR=0.0.0.0
#  Windows-резерв (56):            BIND_ADDR=127.0.0.1 (за nginx на :80)
BIND_ADDR=0.0.0.0
APP_PORT=8080

# --- Данные (Яндекс.Диск) ----------------------------------------------------
#  Debian 103:  HOST_YADISK_PATH=/srv/myflask/data   (локальная синхронизация с 56/WebDAV)
#  Windows 56:  HOST_YADISK_PATH=C:/YandexDisk       (папка синхронизации Яндекс.Диска)
HOST_YADISK_PATH=/srv/myflask/data

# --- Пути к контенту ВНУТРИ контейнера (относительно /data) ------------------
MYFLASK_CONTENT_DIR=/data/Obsidian Vault
CARDS_CONTENT_DIR=/data

# --- Отказоустойчивость -------------------------------------------------------
# Адрес соседнего узла для nginx failover (см. deploy/README.md)
#  на 56:  PEER_HOST=192.168.1.103
#  на 103: PEER_HOST=192.168.1.56
PEER_HOST=192.168.1.103
