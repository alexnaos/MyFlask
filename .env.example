# =============================================================================
# myflask — переменные окружения для docker-compose.yml (прод)
# Скопируйте в .env рядом с docker-compose.yml и заполните. .env НЕ коммитить.
# =============================================================================

# --- Образ / реестр ----------------------------------------------------------
IMAGE=ghcr.io/alexnaos/myflask:latest

# --- Адрес прослушивания контейнера app -------------------------------------
#  Orange Pi (основной):  BIND_ADDR=0.0.0.0   (Nginx на Windows стучится на 192.168.1.23:8080)
#  Windows (резерв):      BIND_ADDR=127.0.0.1 (только локальный Nginx)
BIND_ADDR=0.0.0.0
APP_PORT=8080

# --- Данные (Яндекс.Диск) ----------------------------------------------------
#  Orange Pi:  HOST_YADISK_PATH=/mnt/yadisk      (rclone автомонтирование)
#  Windows:    HOST_YADISK_PATH=C:/YandexDisk     (папка синхронизации Яндекс.Диска)
# Весь КОРЕНЬ Яндекс.Диска монтируется в /data внутри контейнера (только чтение).
HOST_YADISK_PATH=/mnt/yadisk

# --- Пути к контенту ВНУТРИ контейнера (относительно /data) ------------------
# MyFlask читает Obsidian-заметки из своей подпапки внутри монтирования
MYFLASK_CONTENT_DIR=/data/Obsidian Vault
# ProjectCards берёт карточки из корня монтирования /data
CARDS_CONTENT_DIR=/data