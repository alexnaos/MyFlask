# Orange Pi (ОСНОВНОЙ сервер): копируем в /opt/flask-mirror/.env
IMAGE=ghcr.io/alexnaos/myflask:latest

# Слушаем на всех интерфейсах, чтобы Nginx на Windows доставал 192.168.1.23:8080
BIND_ADDR=0.0.0.0
APP_PORT=8080

# rclone автомонтирование Яндекс.Диска (весь корень монтируется в /data)
HOST_YADISK_PATH=/mnt/yadisk

# Пути к контенту внутри контейнера (относительно /data)
MYFLASK_CONTENT_DIR=/data/Obsidian Vault
CARDS_CONTENT_DIR=/data