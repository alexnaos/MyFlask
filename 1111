services:
  convertx:
    image: ghcr.io/c4illin/convertx
    container_name: convertx
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      - JWT_SECRET=3c8e495e905ccb0483bf1790739e030ef5a58bba9d2039ffeadbad2496ed5fcf
      - PUID=1000 # Ваш UID (проверьте командой id -u)
      - PGID=1000 # Ваш GID (проверьте командой id -g)
      # - HTTP_ALLOWED=true # Раскомментируйте, если будете заходить по IP без HTTPS
    volumes:
      - ./data:/app/data